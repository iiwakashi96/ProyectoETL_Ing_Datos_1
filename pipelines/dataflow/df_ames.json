{
    "name": "df_ames",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "ds_csv_ames",
                        "type": "DatasetReference"
                    },
                    "name": "csv"
                },
                {
                    "dataset": {
                        "referenceName": "ds_pg_ames",
                        "type": "DatasetReference"
                    },
                    "name": "postgres"
                },
                {
                    "dataset": {
                        "referenceName": "ds_stg_pool",
                        "type": "DatasetReference"
                    },
                    "name": "pool"
                },
                {
                    "dataset": {
                        "referenceName": "ds_stg_garage",
                        "type": "DatasetReference"
                    },
                    "name": "garage"
                },
                {
                    "dataset": {
                        "referenceName": "ds_stg_bsmt",
                        "type": "DatasetReference"
                    },
                    "name": "bsmt"
                },
                {
                    "dataset": {
                        "referenceName": "ds_stg_misc",
                        "type": "DatasetReference"
                    },
                    "name": "misc"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "ds_salida",
                        "type": "DatasetReference"
                    },
                    "name": "salida"
                }
            ],
            "transformations": [
                {
                    "name": "unirPostgres"
                },
                {
                    "name": "unirPool"
                },
                {
                    "name": "unirGarage"
                },
                {
                    "name": "unirBsmt"
                },
                {
                    "name": "unirMisc"
                },
                {
                    "name": "arreglar"
                },
                {
                    "name": "ordenar"
                }
            ],
            "scriptLines": [
                "source(output(",
                "          PID as long,",
                "          {Lot Frontage} as string,",
                "          {Lot Area} as string,",
                "          Street as string,",
                "          Alley as string,",
                "          {Lot Shape} as string,",
                "          {Land Contour} as string,",
                "          Utilities as string,",
                "          {Lot Config} as string,",
                "          {Land Slope} as string,",
                "          Neighborhood as string,",
                "          {Condition 1} as string,",
                "          {Condition 2} as string,",
                "          {Bldg Type} as string,",
                "          {House Style} as string,",
                "          {Overall Qual} as string,",
                "          {Overall Cond} as string,",
                "          {Year Built} as string,",
                "          {Year Remod/Add} as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> csv",
                "source(output(",
                "          PID as long,",
                "          {MS SubClass} as long,",
                "          {MS Zoning} as string,",
                "          {Roof Style} as string,",
                "          {Roof Matl} as string,",
                "          {Exterior 1st} as string,",
                "          {Exterior 2nd} as string,",
                "          {Mas Vnr Type} as string,",
                "          {Mas Vnr Area} as long,",
                "          {Exter Qual} as string,",
                "          {Exter Cond} as string,",
                "          Foundation as string,",
                "          Heating as string,",
                "          {Heating QC} as string,",
                "          {Central Air} as string,",
                "          Electrical as string,",
                "          {1st Flr SF} as long,",
                "          {2nd Flr SF} as long,",
                "          {Low Qual Fin SF} as long,",
                "          {Gr Liv Area} as long,",
                "          {Full Bath} as integer,",
                "          {Half Bath} as integer,",
                "          {Bedroom AbvGr} as integer,",
                "          {Kitchen AbvGr} as long,",
                "          {Kitchen Qual} as string,",
                "          {TotRms AbvGrd} as long,",
                "          Functional as string,",
                "          Fireplaces as long,",
                "          {Fireplace Qu} as string,",
                "          {Paved Drive} as string,",
                "          {Wood Deck SF} as long,",
                "          {Open Porch SF} as long,",
                "          {Enclosed Porch} as long,",
                "          {3Ssn Porch} as long,",
                "          {Screen Porch} as long,",
                "          Fence as string,",
                "          {Mo Sold} as integer,",
                "          {Yr Sold} as integer,",
                "          {Sale Type} as string,",
                "          {Sale Condition} as string,",
                "          SalePrice as long",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     isolationLevel: 'READ_UNCOMMITTED',",
                "     query: 'SELECT\\n    a.pid                                                  AS \"PID\",\\n    a.\"MS SubClass\"                                        AS \"MS SubClass\",\\n    z.code                                                 AS \"MS Zoning\",\\n    a.\"Roof Style\"                                         AS \"Roof Style\",\\n    a.\"Roof Matl\"                                          AS \"Roof Matl\",\\n    a.\"Exterior 1st\"                                       AS \"Exterior 1st\",\\n    a.\"Exterior 2nd\"                                       AS \"Exterior 2nd\",\\n    COALESCE(a.\"Mas Vnr Type\", \\'NA\\')                       AS \"Mas Vnr Type\",\\n    COALESCE(a.\"Mas Vnr Area\", 0)                          AS \"Mas Vnr Area\",\\n    eq.code                                                AS \"Exter Qual\",\\n    ec.code                                                AS \"Exter Cond\",\\n    a.foundation                                           AS \"Foundation\",\\n    a.heating                                              AS \"Heating\",\\n    hq.code                                                AS \"Heating QC\",\\n    CASE WHEN a.\"Central Air\" THEN \\'Y\\' ELSE \\'N\\' END        AS \"Central Air\",\\n    COALESCE(a.electrical, \\'NA\\')                           AS \"Electrical\",\\n    a.\"1st Flr SF\"                                         AS \"1st Flr SF\",\\n    a.\"2nd Flr SF\"                                         AS \"2nd Flr SF\",\\n    a.\"Low Qual Fin SF\"                                    AS \"Low Qual Fin SF\",\\n    a.\"1st Flr SF\" + a.\"2nd Flr SF\" + a.\"Low Qual Fin SF\"  AS \"Gr Liv Area\",\\n    COALESCE(p.fullbath, 0)                                AS \"Full Bath\",\\n    COALESCE(p.halfbath, 0)                                AS \"Half Bath\",\\n    COALESCE(p.bedroom, 0)                                 AS \"Bedroom AbvGr\",\\n    a.\"Kitchen AbvGr\"                                      AS \"Kitchen AbvGr\",\\n    kq.code                                                AS \"Kitchen Qual\",\\n    a.\"TotRms AbvGrd\"                                      AS \"TotRms AbvGrd\",\\n    a.functional                                           AS \"Functional\",\\n    a.fireplaces                                           AS \"Fireplaces\",\\n    a.\"Fireplace Qu\"                                       AS \"Fireplace Qu\",\\n    a.\"Paved Drive\"                                        AS \"Paved Drive\",\\n    a.\"Wood Deck SF\"                                       AS \"Wood Deck SF\",\\n    a.\"Open Porch SF\"                                      AS \"Open Porch SF\",\\n    a.\"Enclosed Porch\"                                     AS \"Enclosed Porch\",\\n    a.\"3Ssn Porch\"                                         AS \"3Ssn Porch\",\\n    a.\"Screen Porch\"                                       AS \"Screen Porch\",\\n    a.fence                                                AS \"Fence\",\\n    CAST(EXTRACT(MONTH FROM s.\"Sale Date\") AS integer)     AS \"Mo Sold\",\\n    CAST(EXTRACT(YEAR  FROM s.\"Sale Date\") AS integer)     AS \"Yr Sold\",\\n    s.\"Sale Type\"                                          AS \"Sale Type\",\\n    s.\"Sale Condition\"                                     AS \"Sale Condition\",\\n    s.saleprice                                            AS \"SalePrice\"\\nFROM public.amesdbtemp a\\nLEFT JOIN public.mszoning     z  ON z.id  = a.\"MS Zoning\"\\nLEFT JOIN public.typequality  eq ON eq.id = a.\"Exter Qual\"\\nLEFT JOIN public.typequality  ec ON ec.id = a.\"Exter Cond\"\\nLEFT JOIN public.typequality  hq ON hq.id = a.\"Heating QC\"\\nLEFT JOIN public.typequality  kq ON kq.id = a.\"Kitchen Qual\"\\nLEFT JOIN public.saleproperty s  ON s.pid = a.pid\\nLEFT JOIN (\\n    SELECT pid,\\n           CAST(SUM(bedrooms)    AS integer) AS bedroom,\\n           CAST(SUM(\"Full Bath\") AS integer) AS fullbath,\\n           CAST(SUM(\"Half Bath\") AS integer) AS halfbath\\n    FROM public.floordetail\\n    GROUP BY pid\\n) p ON p.pid = a.pid',",
                "     format: 'query') ~> postgres",
                "source(output(",
                "          PID as long,",
                "          {Pool Area} as short,",
                "          {Pool QC} as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> pool",
                "source(output(",
                "          PID as long,",
                "          {Garage Type} as string,",
                "          {Garage Yr Blt} as short,",
                "          {Garage Finish} as string,",
                "          {Garage Cars} as short,",
                "          {Garage Area} as short,",
                "          {Garage Qual} as string,",
                "          {Garage Cond} as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> garage",
                "source(output(",
                "          PID as long,",
                "          {Bsmt Qual} as string,",
                "          {Bsmt Cond} as string,",
                "          {Bsmt Exposure} as string,",
                "          {BsmtFin Type 1} as string,",
                "          {BsmtFin SF 1} as short,",
                "          {BsmtFin Type 2} as string,",
                "          {BsmtFin SF 2} as short,",
                "          {Bsmt Unf SF} as short,",
                "          {Total Bsmt SF} as short,",
                "          {Bsmt Full Bath} as short,",
                "          {Bsmt Half Bath} as short",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> bsmt",
                "source(output(",
                "          PID as long,",
                "          {Misc Feature} as string,",
                "          {Misc Val} as short",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> misc",
                "csv, postgres join(csv@PID == postgres@PID,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> unirPostgres",
                "unirPostgres, pool join(csv@PID == pool@PID,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> unirPool",
                "unirPool, garage join(csv@PID == garage@PID,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> unirGarage",
                "unirGarage, bsmt join(csv@PID == bsmt@PID,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> unirBsmt",
                "unirBsmt, misc join(csv@PID == misc@PID,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> unirMisc",
                "unirMisc derive({Year Remod/Add} = iifNull({Year Remod/Add}, {Year Built}),",
                "          {Pool QC} = iifNull({Pool QC}, 'NA'),",
                "          {Pool Area} = iifNull({Pool Area}, 0),",
                "          {Garage Type} = iifNull({Garage Type}, 'NA'),",
                "          {Garage Finish} = iifNull({Garage Finish}, 'NA'),",
                "          {Garage Qual} = iifNull({Garage Qual}, 'NA'),",
                "          {Garage Cond} = iifNull({Garage Cond}, 'NA'),",
                "          {Bsmt Qual} = iifNull({Bsmt Qual}, 'NA'),",
                "          {Bsmt Cond} = iifNull({Bsmt Cond}, 'NA'),",
                "          {Bsmt Exposure} = iifNull({Bsmt Exposure}, 'NA'),",
                "          {BsmtFin Type 1} = iifNull({BsmtFin Type 1}, 'NA'),",
                "          {BsmtFin Type 2} = iifNull({BsmtFin Type 2}, 'NA'),",
                "          {Misc Feature} = iifNull({Misc Feature}, 'NA'),",
                "          {Garage Yr Blt} = iifNull({Garage Yr Blt}, 0),",
                "          {Garage Cars} = iifNull({Garage Cars}, 0),",
                "          {Garage Area} = iifNull({Garage Area}, 0),",
                "          {BsmtFin SF 1} = iifNull({BsmtFin SF 1}, 0),",
                "          {BsmtFin SF 2} = iifNull({BsmtFin SF 2}, 0),",
                "          {Bsmt Unf SF} = iifNull({Bsmt Unf SF}, 0),",
                "          {Total Bsmt SF} = iifNull({Total Bsmt SF}, 0),",
                "          {Bsmt Full Bath} = iifNull({Bsmt Full Bath}, 0),",
                "          {Bsmt Half Bath} = iifNull({Bsmt Half Bath}, 0),",
                "          {Misc Val} = iifNull({Misc Val}, 0),",
                "          {Lot Shape} = case(",
                "    {Lot Shape} == 'Regular', 'Reg',",
                "    {Lot Shape} == 'Slightly irregular', 'IR1',",
                "    {Lot Shape} == 'Moderately Irregular', 'IR2',",
                "    {Lot Shape} == 'Irregular', 'IR3',",
                "    {Lot Shape}",
                "),",
                "          Neighborhood = case(",
                "    Neighborhood == 'Bloomington Heights', 'Blmngtn',",
                "    Neighborhood == 'Bluestem', 'Blueste',",
                "    Neighborhood == 'Briardale', 'BrDale',",
                "    Neighborhood == 'Brookside', 'BrkSide',",
                "    Neighborhood == 'Clear Creek', 'ClearCr',",
                "    Neighborhood == 'College Creek', 'CollgCr',",
                "    Neighborhood == 'Crawford', 'Crawfor',",
                "    Neighborhood == 'Iowa DOT and Rail Road', 'IDOTRR',",
                "    Neighborhood == 'Meadow Village', 'MeadowV',",
                "    Neighborhood == 'Mitchell', 'Mitchel',",
                "    Neighborhood == 'North Ames', 'Names',",
                "    Neighborhood == 'Northridge', 'NoRidge',",
                "    Neighborhood == 'Northpark Villa', 'NPkVill',",
                "    Neighborhood == 'Northridge Heights', 'NridgHt',",
                "    Neighborhood == 'Northwest Ames', 'NWAmes',",
                "    Neighborhood == 'Old Town', 'OldTown',",
                "    Neighborhood == 'South & West of Iowa State University', 'SWISU',",
                "    Neighborhood == 'Sawyer West', 'SawyerW',",
                "    Neighborhood == 'Somerset', 'Somerst',",
                "    Neighborhood == 'Stone Brook', 'StoneBr',",
                "    Neighborhood == 'Timberland', 'Timber',",
                "    Neighborhood",
                "),",
                "          {Condition 1} = case(     {Condition 1} == 'Normal', 'Norm',     {Condition 1} == 'Adjacent to feeder street', 'Feedr',     {Condition 1} == 'Adjacent to arterial street', 'Artery',     {Condition 1} == 'Adjacent to East-West Railroad', 'RRAe',     {Condition 1} == 'Adjacent to North-South Railroad', 'RRAn',     startsWith({Condition 1}, 'Within 200') && endsWith({Condition 1}, 'North-South Railroad'), 'RRNn',     startsWith({Condition 1}, 'Within 200') && endsWith({Condition 1}, 'East-West Railroad'), 'RRNe',     startsWith({Condition 1}, 'Near positive'), 'PosN',     startsWith({Condition 1}, 'Adjacent to pos'), 'PosA',     {Condition 1} ),",
                "          {Condition 2} = case(     {Condition 2} == 'Normal', 'Norm',     {Condition 2} == 'Adjacent to feeder street', 'Feedr',     {Condition 2} == 'Adjacent to arterial street', 'Artery',     {Condition 2} == 'Adjacent to East-West Railroad', 'RRAe',     {Condition 2} == 'Adjacent to North-South Railroad', 'RRAn',     startsWith({Condition 2}, 'Within 200') && endsWith({Condition 2}, 'North-South Railroad'), 'RRNn',     startsWith({Condition 2}, 'Within 200') && endsWith({Condition 2}, 'East-West Railroad'), 'RRNe',     startsWith({Condition 2}, 'Near positive'), 'PosN',     startsWith({Condition 2}, 'Adjacent to pos'), 'PosA',     {Condition 2} ),",
                "          {Lot Frontage} = iif(isNull({Lot Frontage}) || trim({Lot Frontage}) == '', '0', {Lot Frontage}),",
                "          {Sale Type} = trim({Sale Type})) ~> arreglar",
                "arreglar select(mapColumn(",
                "          PID = csv@PID,",
                "          MS_sub_class = {MS SubClass},",
                "          MS_zoning = {MS Zoning},",
                "          lot_frontage = {Lot Frontage},",
                "          lot_area = {Lot Area},",
                "          street = Street,",
                "          alley = Alley,",
                "          lot_shape = {Lot Shape},",
                "          land_contour = {Land Contour},",
                "          utilities = Utilities,",
                "          lot_config = {Lot Config},",
                "          land_slope = {Land Slope},",
                "          neighborhood = Neighborhood,",
                "          condition_1 = {Condition 1},",
                "          condition_2 = {Condition 2},",
                "          bldg_type = {Bldg Type},",
                "          house_style = {House Style},",
                "          overall_qual = {Overall Qual},",
                "          overall_cond = {Overall Cond},",
                "          year_built = {Year Built},",
                "          year_remod_add = {Year Remod/Add},",
                "          roof_style = {Roof Style},",
                "          roof_matl = {Roof Matl},",
                "          exterior_1st = {Exterior 1st},",
                "          exterior_2nd = {Exterior 2nd},",
                "          mas_vnr_type = {Mas Vnr Type},",
                "          mas_vnr_area = {Mas Vnr Area},",
                "          exter_qual = {Exter Qual},",
                "          exter_cond = {Exter Cond},",
                "          foundation = Foundation,",
                "          bsmt_qual = {Bsmt Qual},",
                "          bsmt_cond = {Bsmt Cond},",
                "          bsmt_exposure = {Bsmt Exposure},",
                "          bsmt_fin_type_1 = {BsmtFin Type 1},",
                "          bsmt_fin_sf_1 = {BsmtFin SF 1},",
                "          bsmt_fin_type_2 = {BsmtFin Type 2},",
                "          bsmt_fin_sf_2 = {BsmtFin SF 2},",
                "          bsmt_unf_sf = {Bsmt Unf SF},",
                "          total_bsmt_sf = {Total Bsmt SF},",
                "          heating = Heating,",
                "          heating_QC = {Heating QC},",
                "          central_air = {Central Air},",
                "          electrical = Electrical,",
                "          {1st_flr_sf} = {1st Flr SF},",
                "          {2nd_flr_sf} = {2nd Flr SF},",
                "          low_qual_fin_sf = {Low Qual Fin SF},",
                "          gr_liv_area = {Gr Liv Area},",
                "          bsmt_full_bath = {Bsmt Full Bath},",
                "          bsmt_half_bath = {Bsmt Half Bath},",
                "          full_bath = {Full Bath},",
                "          half_bath = {Half Bath},",
                "          bedroom = {Bedroom AbvGr},",
                "          kitchen_abv_gr = {Kitchen AbvGr},",
                "          kitchen_qual = {Kitchen Qual},",
                "          tot_rms_abv_grd = {TotRms AbvGrd},",
                "          functional = Functional,",
                "          fireplaces = Fireplaces,",
                "          fireplace_qu = {Fireplace Qu},",
                "          garage_type = {Garage Type},",
                "          garage_yr_blt = {Garage Yr Blt},",
                "          garage_finish = {Garage Finish},",
                "          garage_cars = {Garage Cars},",
                "          garage_area = {Garage Area},",
                "          garage_qual = {Garage Qual},",
                "          garage_cond = {Garage Cond},",
                "          paved_drive = {Paved Drive},",
                "          wood_deck_sf = {Wood Deck SF},",
                "          open_porch_sf = {Open Porch SF},",
                "          enclosed_porch = {Enclosed Porch},",
                "          {3ssn_porch} = {3Ssn Porch},",
                "          screen_porch = {Screen Porch},",
                "          pool_area = {Pool Area},",
                "          pool_QC = {Pool QC},",
                "          fence = Fence,",
                "          misc_feature = {Misc Feature},",
                "          misc_val = {Misc Val},",
                "          mo_sold = {Mo Sold},",
                "          yr_sold = {Yr Sold},",
                "          sale_type = {Sale Type},",
                "          sale_condition = {Sale Condition},",
                "          sale_price = SalePrice",
                "     ),",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true) ~> ordenar",
                "ordenar sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     partitionFileNames:['salida.csv'],",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true,",
                "     partitionBy('hash', 1)) ~> salida"
            ]
        }
    }
}